NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend session validation uses the Supabase public/anonymous key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/auth/callback

# Google Drive OAuth (configure a Web OAuth client in Google Cloud Console)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive/auth/callback

# Shared Google Calendar used to create workspace meetings and Google Meet links.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=http://localhost:3000/api/meetings/calendar/auth/callback
MEETING_ADMIN_EMAILS=
MEETING_REMINDER_POLL_SECONDS=30

# Keep this stable and server-side. It encrypts OAuth/MSAL token caches.
SOURCE_CREDENTIALS_KEY=

# AI providers (server-side only)
OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Hugging Face Inference Providers (HF_TOKEN needs Inference Providers permission)
HF_TOKEN=
HF_CHAT_MODEL=openai/gpt-oss-120b:cheapest
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Optional: customize the Qwen query-side retrieval instruction
HF_EMBEDDING_QUERY_INSTRUCTION=Given a question, retrieve relevant passages that answer the question
